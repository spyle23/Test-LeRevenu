# Read by docker compose. `node scripts/setup-env.mjs` copies this file to .env
# and replaces every "change-me" with a random secret.

# PostgreSQL (local only; backend/.env.example uses the same credentials)
DATABASE_NAME=lerevenu_community
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_HOST_PORT=5433

# Strapi secrets
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Demo community (members share this password)
SEED_DEMO_DATA=true
DEMO_USERS_PASSWORD=Revenu2026!
