{
  "kind": "collectionType",
  "collectionName": "discussions",
  "info": {
    "singularName": "discussion",
    "pluralName": "discussions",
    "displayName": "Discussion",
    "description": "Question ou discussion lancée par un membre"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 10,
      "maxLength": 160
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "content": {
      "type": "text",
      "required": true,
      "maxLength": 10000
    },
    "type": {
      "type": "enumeration",
      "enum": ["question", "discussion"],
      "default": "question",
      "required": true
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "discussions"
    },
    "replies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reply.reply",
      "mappedBy": "discussion"
    },
    "replyCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "lastActivityAt": {
      "type": "datetime"
    }
  },
  "indexes": [
    { "name": "discussions_created_at_idx", "columns": ["created_at"] },
    { "name": "discussions_reply_count_idx", "columns": ["reply_count", "last_activity_at"] }
  ]
}
